<odoo> <record id="view_profit_cashflow_analysis_list" model="ir.ui.view"> <field name="name">profit.cashflow.analysis.list</field> <field name="model">profit.cashflow.analysis</field> <field name="arch" type="xml"> <list> <field name="name"/> <field name="create_date"/> <field name="overdue_amount"/> <field name="payment_risk"/> <field name="risk_level"/> <field name="state"/> </list> </field> </record>
<record id="view_profit_cashflow_analysis_form" model="ir.ui.view">
    <field name="name">profit.cashflow.analysis.form</field>
    <field name="model">profit.cashflow.analysis</field>
    <field name="arch" type="xml">
        <form>
            <header>
                <button name="action_analyze" string="Analyze with AI"
                        type="object" class="btn-primary"/>
                <field name="state" widget="statusbar"/>
            </header>
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <group string="Figures">
                    <group>
                        <field name="total_revenue"/>
                        <field name="total_expenses"/>
                        <field name="profit"/>
                    </group>
                    <group>
                        <field name="outstanding_amount"/>
                        <field name="overdue_amount"/>
                        <field name="cash_forecast"/>
                        <field name="payment_risk"/>
                    </group>
                </group>
                <group string="AI Analysis">
                    <field name="risk_level"/>
                    <field name="summary" nolabel="1" colspan="2"/>
                    <field name="reminders" nolabel="1" colspan="2"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

<record id="action_profit_cashflow_analysis" model="ir.actions.act_window">
    <field name="name">Financial Analyses</field>
    <field name="res_model">profit.cashflow.analysis</field>
    <field name="view_mode">list,form</field>
</record>
</odoo>